# Server Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Gemini API Configuration (Get your key from https://aistudio.google.com/)
GEMINI_API_KEY=

# OCR Configuration
# If Tesseract is installed locally on Windows, provide the path to tesseract.exe:
# e.g., C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Supabase Configuration (Optional - for saving report history & user auth)
SUPABASE_URL=
SUPABASE_KEY=

# Telegram Bot Configuration (Optional - for Telegram report bot)
# Get your token from @BotFather on Telegram
# NEVER share or commit this token
TELEGRAM_BOT_TOKEN=
